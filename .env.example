# Публичные значения Supabase (не секретные; доступ защищён RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Адрес сайта (для ссылок приглашений и писем)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Соль для хэширования IP в антиспаме формы (секрет, задать в Vercel)
LEAD_IP_SALT=change-me
